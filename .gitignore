# Runtime downloads, engine state and local Python tooling
.tools/
.godot/
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.coverage
.env
.env.*
*.local.env

# Generated run output is opt-in evidence, never a blanket milestone allowlist.
verification/**
!verification/.gitkeep
!verification/.gdignore
!verification/*.md
!verification/poc*/
!verification/poc*/*.md
!verification/poc*/*summary*.json
!verification/poc*/acceptance*.json
!verification/poc*/change-manifest.json

# Authored RoomDefinition/reproduction fixtures remain addable.
!verification/poc2/candidates/
!verification/poc2/candidates/**/
!verification/poc2/candidates/**/*.json
!verification/poc2/candidates/**/*.md
!verification/poc2/fixtures/
!verification/poc2/fixtures/*.json

# Stabilization publishes compact reports/manifests; raw runs stay local.
!verification/stabilization/
!verification/stabilization/*.md
!verification/stabilization/*.json
verification/stabilization/runs/

# Existing tracked milestone evidence stays tracked regardless of ignore rules.
# New canonical images/raw campaigns require a deliberate git add -f review.
verification/**/*.import
verification/**/*.uid
verification/**/*.translation

verification/**/*.tmp
photo_holder/**/*.import
screenshots/**/*.import
*.stdout.tmp
*.stderr.tmp

# Active evidence-audit code is source, even under verification.
!verification/poc472/gather_evidence.py
